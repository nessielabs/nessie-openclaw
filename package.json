{
  "name": "@nessielabs/nessie-openclaw",
  "version": "0.1.23",
  "type": "module",
  "description": "OpenClaw OAuth setup helper and skill guidance for hosted Nessie MCP.",
  "license": "MIT-0",
  "homepage": "https://nessielabs.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nessielabs/nessie-openclaw.git"
  },
  "files": [
    "index.js",
    "openclaw.plugin.json",
    "skills",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "validate": "bash scripts/validate.sh",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath scripts/hooks || true"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.5",
      "minGatewayVersion": "2026.6.5"
    },
    "build": {
      "openclawVersion": "2026.6.5",
      "pluginSdkVersion": "2026.6.5"
    }
  }
}
